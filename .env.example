# Copiez ce fichier en .env et remplacez les valeurs. Ne commitez jamais .env.

# Base de données
POSTGRES_DB=kaom
POSTGRES_USER=kaom
POSTGRES_PASSWORD=changez-moi-mot-de-passe-base

# Sécurité : chaîne aléatoire d'au moins 32 caractères (ex. : openssl rand -base64 48)
KAOM_JWT_SECRET=changez-moi-avec-une-longue-chaine-aleatoire-de-48-caracteres

# Compte de la créatrice, créé au premier démarrage (mot de passe : 10 caractères minimum)
KAOM_ADMIN_EMAIL=creatrice@example.com
KAOM_ADMIN_PASSWORD=changez-moi-mot-de-passe
KAOM_ADMIN_NAME=Créatrice KAOM

# Boutique
KAOM_WHATSAPP=221770000000
KAOM_INSTAGRAM=beauty_of_sahel
KAOM_EMAIL=contact@example.com
KAOM_ADDRESS=Dakar, Sénégal
KAOM_FREE_SHIPPING=50000

# Adresse publique du site (autorisée à appeler l'API)
KAOM_CORS_ORIGINS=http://localhost
WEB_PORT=80

# Catalogue de démonstration : laisser vide (KAOM_DEMO_LOCATION=) pour ne PAS le charger
KAOM_DEMO_LOCATION=,classpath:db/demo

# Version des images (latest, develop, ou un tag v1.0.0)
KAOM_TAG=latest
